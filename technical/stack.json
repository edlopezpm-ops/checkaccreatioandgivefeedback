{
  "product": "accreatio",
  "version": "0.8.0",
  "sourceHead": "70612512e2115036fa71a08075a596a04bbff942",
  "versionsAre": "Declared package.json versions, not a remote-runtime or compatibility verification",
  "dependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "client-zip": "2.5.0",
    "concurrently": "10.0.6",
    "electron": "43.8.1",
    "electron-builder": "26.15.3",
    "idb": "8.0.3",
    "lighthouse": "13.4.1",
    "lucide-react": "1.28.0",
    "openid-client": "6.8.8",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "1.3.0",
    "wait-on": "9.1.0",
    "wrangler": "4.151.3"
  },
  "overrides": {
    "undici@7.28.0": "7.29.1",
    "nanoid@3.3.16": "3.3.18"
  },
  "scripts": {
    "log": "node scripts/run-logged.mjs",
    "dev": "concurrently -k \"vite --mode desktop\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on tcp:5173 file:dist-electron/electron/main.js && electron .\"",
    "dev:web": "vite --mode web",
    "build": "npm run build:web && npm run build:desktop",
    "build:web": "tsc -p tsconfig.app.json && vite build --mode web",
    "build:desktop": "tsc -p tsconfig.app.json && vite build --mode desktop && tsc -p electron/tsconfig.json",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:electron": "node scripts/electron-execute-smoke.mjs",
    "test:project-map": "node scripts/project-map-functional-smoke.mjs",
    "test:surface": "node scripts/surface-boundary-smoke.mjs",
    "test:web": "node scripts/web-functional-smoke.mjs",
    "test:account": "node --import tsx scripts/account-functional-smoke.mjs",
    "test:account-mailer": "node workers/account-mailer/verify.mjs",
    "blog:seed:check": "node scripts/generate-blog-seed.mjs --check",
    "aekr:vendor": "node scripts/vendor-aekr-payload.mjs",
    "aekr:vendor:check": "node scripts/vendor-aekr-payload.mjs --check",
    "cloudflare:functions:build": "wrangler pages functions build functions --outdir .local/cache/cloudflare/functions-build",
    "cloudflare:types:check": "wrangler types functions/types.d.ts --config wrangler.toml --include-runtime false --check",
    "project-map:build": "node scripts/generate-project-map.mjs",
    "project-map:check": "node scripts/generate-project-map.mjs --check",
    "brand:render": "node scripts/render-brand-assets.mjs",
    "typecheck": "tsc -p tsconfig.app.json --pretty false && tsc -p electron/tsconfig.json --noEmit --pretty false && npm run typecheck:functions",
    "typecheck:functions": "tsc -p tsconfig.functions.json --pretty false",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"shared/**/*.ts\" \"functions/_lib/**/*.ts\" \"functions/api/**/*.ts\" \"workers/account-maintenance/**/*.ts\" \"content/**/*.json\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"shared/**/*.ts\" \"functions/_lib/**/*.ts\" \"functions/api/**/*.ts\" \"workers/account-maintenance/**/*.ts\" \"content/**/*.json\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "preview": "vite preview",
    "lighthouse": "node scripts/lighthouse-check.mjs",
    "security:inventory": "node scripts/security-inventory.mjs",
    "verify": "npm test && npm run test:account-mailer && npm run aekr:branding:check && npm run blog:seed:check && npm run aekr:vendor:check && npm run project-map:check && npm run cloudflare:types:check && npm run typecheck && npm run format:check && npm run cloudflare:functions:build && npm run build && npm run test:surface && npm run test:electron && npm run test:project-map && npm run test:web && npm run test:account && npm run lighthouse",
    "package:win": "npm run build:desktop && electron-builder --win portable",
    "aekr:branding:check": "node scripts/check-aekr-branding.mjs"
  }
}
