const hash=async(t:string)=>Buffer.from(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(t))).toString('hex');
async function seed(s:Store,env:any,action?:string, rights=false) {
  const id=crypto.randomUUID(),token=Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('hex'),tokenHash=await hash(token);
  const encrypted=await protectEmail('auditoria+nuevo@example.test',id,env,deps(s));
  const name=await protectDisplayName('Auditoría Ñandú 482',id,env,deps(s));
  s.sqlite.prepare('INSERT INTO accounts(id,identity_key,email_ciphertext,email_encryption_key_version,email_lookup_key,display_name_ciphertext,created_at,last_seen_at) VALUES(?,?,?,?,?,?,?,?)').run(id,`fixture:${id}`,encrypted.ciphertext,encrypted.keyVersion,encrypted.lookupKey,name,s.time,s.time);
  s.sqlite.prepare('INSERT INTO account_sessions(token_hash,account_id,expires_at) VALUES(?,?,?)').run(tokenHash,id,s.time+(rights?300000:86400000));
  s.sqlite.prepare('INSERT INTO account_session_metadata(token_hash,method,authenticated_at,security_version,verification_action,rights_only) VALUES(?,?,?,?,?,?)').run(tokenHash,'oidc',s.time,0,action??null,rights?1:0);
  return {id,token,tokenHash};
}
