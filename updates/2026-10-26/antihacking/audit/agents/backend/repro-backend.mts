let dbIndex = 0;
class Store {
  sqlite: DatabaseSync;
  filename: string;
  time = Math.floor(Date.now() / 1000) * 1000;
  fail = false;
  constructor(filename?: string, migrate = true) {
    this.filename = filename ?? path.join(out, `fixture-${process.pid}-${dbIndex++}.sqlite`);
    this.sqlite = new DatabaseSync(this.filename);
    this.sqlite.exec('PRAGMA foreign_keys=ON');
    this.sqlite.function('unixepoch', () => Math.floor(this.time / 1000));
    if (migrate) for (const f of readdirSync(path.join(root, 'migrations-auth')).filter(x=>x.endsWith('.sql')).sort()) this.sqlite.exec(readFileSync(path.join(root, 'migrations-auth', f), 'utf8'));
  }
  prepare(sql: string) {
    const store = this;
    let values: any[] = [];
    const read = () => { if(store.fail) throw new Error('injected_database_failure'); return store.sqlite.prepare(sql).all(...values); };
    return {
      bind(...v: any[]) { values = v; return this; },
      async first() { return read()[0] ?? null; },
      async all() { return { success:true, results:read() }; },
      async run() { if(store.fail) throw new Error('injected_database_failure'); const s = store.sqlite.prepare(sql); const r = s.run(...values); return {success:true, meta:{changes:Number(r.changes)}}; },
      read,
    };
  }
  async batch(statements: any[]) {
    if(this.fail) throw new Error('injected_database_failure');
    this.sqlite.exec('BEGIN');
    try { const data=statements.map(s=>({success:true,results:s.read()})); this.sqlite.exec('COMMIT'); return data; }
    catch(e) { this.sqlite.exec('ROLLBACK'); throw e; }
  }
  n(table: string) { return Number(this.sqlite.prepare(`SELECT COUNT(*) AS n FROM ${table}`).get()!.n); }
  reopen() { this.sqlite.close(); this.sqlite=new DatabaseSync(this.filename); this.sqlite.exec('PRAGMA foreign_keys=ON'); this.sqlite.function('unixepoch',()=>Math.floor(this.time/1000)); }
}
